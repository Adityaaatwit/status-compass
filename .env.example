# Stay Valid — environment template
#
# Copy to `.env` (Vite dev) or `.dev.vars` (wrangler / Cloudflare local) and
# fill in your own values. Both are gitignored. NEVER put a real key in this
# file — it is tracked in git.
#
# Everything below is OPTIONAL. With no values set, AI_CHAT_ENABLED stays false
# and "Ask Stay Valid" answers from the local verified corpus. The timeline,
# checkpoints, pathways, checklist, calendar export and DSO meeting kit never
# call a provider under any configuration.

# ---------------------------------------------------------------- AI toggle --

# Master switch. Must be exactly "true" to enable the optional AI layer.
AI_CHAT_ENABLED=false

# Primary provider, then the fallback used ONLY when the primary fails with a
# temporary error (timeout, 429, 5xx). Set AI_FALLBACK_PROVIDER= (empty) for no
# fallback. A provider never falls back to itself.
AI_PROVIDER=gemini
AI_FALLBACK_PROVIDER=groq

# ------------------------------------------------------------------- Gemini --

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Defaults to gemini-2.0-flash when empty.
GEMINI_MODEL=

# --------------------------------------------------------------------- Groq --

# https://console.groq.com/keys
GROQ_API_KEY=
# Defaults to llama-3.3-70b-versatile when empty.
GROQ_MODEL=

# ---------------------------------------------------- Quota protection caps --
#
# All values are clamped in code, so a typo cannot empty a free tier. Lower
# them in production if your quota is tight.

# Longest question accepted, in characters.
AI_MAX_QUESTION_CHARS=1200

# Ceiling on the retrieved context sent with a question. Whole rules are dropped
# to fit rather than truncating mid-sentence.
AI_MAX_CONTEXT_CHARS=12000

# How many recent messages travel with a question. Not the whole conversation.
AI_MAX_HISTORY_MESSAGES=6

# Output cap. Chat answers are meant to be short.
AI_MAX_OUTPUT_TOKENS=600

# Per-request timeout in milliseconds.
AI_TIMEOUT_MS=15000
